          "name": "Zostaje",
          "applicationCategory": "FinanceApplication",
          "operatingSystem": "iOS",
          "description": "Zostaje to aplikacja iOS do budżetu osobistego, rozwijana z myślą o prostym zapisie wydatków i wpływów. Pokazuje, ile zostało z zapisanych pieniędzy, gdzie są one przechowywane i jak wygląda tempo wydawania. Pierwsza wersja działa bez konta i własnego serwera.",
          "url": "https://zostaje.com/",
          "isAccessibleForFree": true,
          "publisher": {
            "@id": "https://zostaje.com/#organization"
          },
          "screenshot": [
            "https://zostaje.com/screenshots/ios/dashboard.png",
            "https://zostaje.com/screenshots/ios/receipt.png",
