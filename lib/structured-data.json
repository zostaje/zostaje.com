        {
          "@type": "SoftwareApplication",
          "@id": "https://zostaje.com/#app",
          "name": "Zostaje",
          "applicationCategory": "FinanceApplication",
          "operatingSystem": "iOS",
          "description": "Zostaje to rozwijana, darmowa aplikacja do planowania budżetu i oszczędności. Pomaga oszacować, ile zostaje do kolejnego wpływu po uwzględnieniu rachunków, własnego bufora i rezerwy na cel. Pierwsze MVP powstaje na iOS.",
          "url": "https://zostaje.com/",
          "isAccessibleForFree": true,
          "publisher": {
            "@id": "https://zostaje.com/#organization"
          }
        },
        {
          "@type": "WebPage",
          "@id": "https://zostaje.com/#webpage",
          "url": "https://zostaje.com/",
          "name": "Zostaje — darmowa aplikacja do budżetu i oszczędności",
          "description": "Zaplanuj budżet do kolejnego wpływu, uwzględnij rachunki i odkładaj na cel. Darmowa aplikacja lokalna bez konta. MVP na iOS w rozwoju.",
          "inLanguage": "pl",
          "isPartOf": {
            "@id": "https://zostaje.com/#website"
          },
          "mainEntity": {
            "@id": "https://zostaje.com/#app"
          }
        },
        {
          "@type": "FAQPage",
          "@id": "https://zostaje.com/#questions",
          "isPartOf": {
            "@id": "https://zostaje.com/#webpage"
          },
          "inLanguage": "pl",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Czym jest Zostaje?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Zostaje to rozwijana, darmowa aplikacja do planowania budżetu i oszczędności. Pomaga oszacować, ile zostaje do kolejnego wpływu po uwzględnieniu rachunków, własnego bufora i rezerwy na cel. Pierwsze MVP powstaje na iOS."
              }
            },
            {
              "@type": "Question",
              "name": "Czy muszę wpisywać każdy wydatek?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Nie. Pierwszy plan opiera się na aktualnym saldzie, terminie kolejnego wpływu, nieopłaconych rachunkach i wybranych rezerwach. Historię można uzupełnić importem w opisanym formacie CSV. Automatyczne integracje bankowe są kierunkiem dalszego rozwoju."
              }
            },
            {
              "@type": "Question",
              "name": "Co jest darmowe, a za co zapłacę?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Pełna aplikacja lokalna ma być darmowa, bez obowiązkowego konta, z możliwością podłączenia własnego AI. Opcjonalne Premium obejmuje obsługę AI przez nas i rozszerzoną analitykę: 39 zł miesięcznie lub 397,80 zł rocznie. Founders Edition to indywidualnie wyceniana wersja dla firm. Płatne usługi są w przygotowaniu."
              }
            },
            {
              "@type": "Question",
              "name": "Czy mogę już pobrać aplikację?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Publiczne instalatory nie są jeszcze dostępne. Na stronie Pobierz sprawdzisz status platform i historię wersji, a zapis do newslettera pozwoli otrzymywać informacje o nowych wersjach i rozwoju projektu."
              }
            }
          ]
        }
      ]
    }
